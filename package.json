{
  "name": "softcut",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "analysis": "sh scripts/run-analysis-config.sh --config configs/project.yaml",
    "analysis:config": "sh scripts/run-analysis-config.sh",
    "planner": "sh scripts/run-plan-config.sh --config configs/project.yaml",
    "planner:config": "sh scripts/run-plan-config.sh",
    "web:dev": "pnpm --filter @softcut/web dev",
    "web:build": "pnpm --filter @softcut/web build",
    "web:test": "pnpm --filter @softcut/web test",
    "install:frozen": "pnpm install --frozen-lockfile",
    "api": "./run api"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3"
  }
}
